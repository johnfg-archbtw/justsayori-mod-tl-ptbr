    # extend bbbcbcag "I w-{w=0.5}w-{w=0.5}would forget you ever existed..."
    extend bbbcbcag "Eu i-{w=0.5}i-{w=0.5}iria esquecer que você até existiu..."

# game/dialogs/script-topics.rpy:2941
