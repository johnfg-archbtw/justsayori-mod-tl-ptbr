    # s abbcaca "And I realized that if something ever happened to that file... {w=0.5}{nw}"
    s abbcaca "E eu notei que se alguma coisa acontecer com esse arquivo... {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:2934
