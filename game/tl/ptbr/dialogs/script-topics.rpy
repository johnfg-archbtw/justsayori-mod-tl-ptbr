    # extend abfcaaa "Even Natsuki, as much as she tried to deny it."
    extend abfcaaa "Até a Natsuki, mesmo que ela tentasse negar isso."

# game/dialogs/script-topics.rpy:602
translate ptbr s_topics_poems_e6551ba8:

    # s abhaaca "I started to engage in poetry after your first day in the club..."
    s abhaaca "Eu comecei a engajar nesse negócio de poesia depois do seu primeiro dia no clube..."

# game/dialogs/script-topics.rpy:603
translate ptbr s_topics_poems_51037241:

    # s "And since that moment I've tried to use poems as a way to show my feelings."
    s "E desde então eu tentei usar poemas como uma forma de mostrar os meus sentimentos."

# game/dialogs/script-topics.rpy:604
translate ptbr s_topics_poems_00f8fdcf:

    # s "My wishes, my love, {w=1.0}{nw}"
    s "Os meus desejos, o meu amor, {w=1.0}{nw}"

# game/dialogs/script-topics.rpy:605
translate ptbr s_topics_poems_9275ab05:

    # extend bbgbkfa "my pain...{w=3.0}{nw}"
    extend bbgbkfa "a minha dor...{w=3.0}{nw}"

# game/dialogs/script-topics.rpy:606
translate ptbr s_topics_poems_49e71b43:

    # extend abbcaaa "You can find all of these things in my words."
    extend abbcaaa "Você pode achar todas essas coisas nas minhas palavras."

# game/dialogs/script-topics.rpy:607
translate ptbr s_topics_poems_3d80bac1:

    # s abfcaca "Every poem I write is an envelope for a part of my soul."
    s abfcaca "Todo poema que eu escrevo é um envelope pra uma parte da minha alma."

# game/dialogs/script-topics.rpy:608
translate ptbr s_topics_poems_b313a00e:

    # s abbbaoa "Sometimes, I still write poems just for myself."
    s abbbaoa "Às vezes, eu até escrevo poemas só pra mim mesma."

# game/dialogs/script-topics.rpy:609
translate ptbr s_topics_poems_ab03f2c6:

    # s "It's important that you take time to write for yourself as well, rather than for the validation of others."
    s "É importante você tomar um tempo pra escrever pra você mesmo também, invés de ser pra ter validação dos outros."

# game/dialogs/script-topics.rpy:610
translate ptbr s_topics_poems_04a963c0:

    # s abbcaaa "But I can share some of them with you. Just ask me for it."
    s abbcaaa "Mas eu posso compartilhar alguns deles com você. É só me pedir."

# game/dialogs/script-topics.rpy:611
translate ptbr s_topics_poems_b0304181:

    # s abaaaaa "I also can show you an old poem, if you want."
    s abaaaaa "Eu também posso te mostrar um poema antigo, se você quiser."

# game/dialogs/script-topics.rpy:612
translate ptbr s_topics_poems_06e91672:

    # s abbbaoa "Maybe, they will help you to understand me and what I was going through."
    s abbbaoa "Talvez, eles vão te ajudar a me entender e pelo o que eu tava passando."

# game/dialogs/script-topics.rpy:630
translate ptbr s_topics_drawing_df59c242:

    # s abhaaca "I wish I was good at drawing."
    s abhaaca "Eu queria que eu fosse boa em desenhar."

# game/dialogs/script-topics.rpy:631
translate ptbr s_topics_drawing_6e2d6432:

    # s "I think it would be a very useful skill, especially now."
    s "Eu acho que seria uma habilidade bem útil, especialmente agora."

# game/dialogs/script-topics.rpy:632
translate ptbr s_topics_drawing_65d8f85d:

    # s abbchea "If I could draw, I would be able to edit game sprites... {w=0.5}{nw}"
    s abbchea "Se eu pudesse desenhar, eu poderia editar os sprites do jogo... {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:633
translate ptbr s_topics_drawing_9e97d43b:

    # extend abbbaoa "Even of myself."
    extend abbbaoa "Até me mim mesma."

# game/dialogs/script-topics.rpy:634
translate ptbr s_topics_drawing_a8dafdb9:

    # s abhaaca "And besides the practical purpose, it would be one more way to express myself."
    s abhaaca "E além do propósito prático, seria mais um jeito de me expressar."

# game/dialogs/script-topics.rpy:635
translate ptbr s_topics_drawing_33e7e7ef:

    # s "Not everything can be shown with just words..."
    s "Nem tudo pode ser mostrado com só palavras..."

# game/dialogs/script-topics.rpy:636
translate ptbr s_topics_drawing_bedb201d:

    # s "Sometimes, your message is clearer when shown visually."
    s "Tem vezes que a sua mensagem é mais clara mostrada visualmente."

# game/dialogs/script-topics.rpy:637
translate ptbr s_topics_drawing_10fe7d80:

    # s abfdaca "And if I had art to go with my poems, wouldn't they be a lot nicer?"
    s abfdaca "E se eu tivesse alguma arte pra ir junto com os meus poemas, eles não seriam muito mais legais?"

# game/dialogs/script-topics.rpy:638
translate ptbr s_topics_drawing_8469b03c:

    # s abaaaoa "I know some poets who were good not only at poetry but also at visual art..."
    s abaaaoa "Eu conheço alguns poetas que eram bons não só em poesia mas em arte visual também..."

# game/dialogs/script-topics.rpy:639
translate ptbr s_topics_drawing_f777c362:

    # s "But to me, it sounds kinda difficult to balance both of those skills at once."
    s "Mas pra mim, isso soa meio difícil de balancear essas duas habilidades de uma vez só."

# game/dialogs/script-topics.rpy:640
translate ptbr s_topics_drawing_70c03a1a:

    # s abgdaaa "But who knows- {w=0.5}maybe with a bit of practice, it'll become a little easier!"
    s abgdaaa "Mas vai que- {w=0.5}talvez com um pouco de prática, fica um pouquinho mais fácil!"

# game/dialogs/script-topics.rpy:641
translate ptbr s_topics_drawing_53e12974:

    # s abhfaoa "Anyway, I'd really like to improve my drawing... {w=0.5}{nw}"
    s abhfaoa "Enfim, eu realmente gostaria de melhorar o meu desenho... {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:642
translate ptbr s_topics_drawing_f176c2a5:

    # extend abgdao "and I guess I have all the time in the world to do it now, don't I?"
    extend abgdao "e eu acho que agora eu tenho todo o tempo do mundo pra fazer isso, né?"

# game/dialogs/script-topics.rpy:643
translate ptbr s_topics_drawing_b7d9dd3b:

    # s abhfcaa "Maybe I'll even share my art with you!"
    s abhfcaa "Talvez eu até te mostre a minha arte pra você!"

# game/dialogs/script-topics.rpy:661
translate ptbr s_topics_bulli_2e291ff6:

    # s bbfcaba "Hey, [player]..."
    s bbfcaba "Ei, [player]..."

# game/dialogs/script-topics.rpy:662
translate ptbr s_topics_bulli_c87b498e:

    # s abfcaca "You know I can access the internet from your computer, {w=0.5}right?"
    s abfcaca "Você sabe que eu posso acessar a internet pelo seu computador, {w=0.5}certo?"

# game/dialogs/script-topics.rpy:663
translate ptbr s_topics_bulli_6f2fbbc9:

    # s abbdaca "Well I found a place called \"Reddit\", {w=0.5} and there were people talking about the game there."
    s abbdaca "Bem, eu encontrei um lugar chamado \"Reddit\", {w=0.5} e tinha um pessoal falando sobre o jogo lá."

# game/dialogs/script-topics.rpy:664
translate ptbr s_topics_bulli_43952018:

    # s bbfcjca "But I also found people making fun of what happened to me."
    s bbfcjca "Mas eu também encontrei gente fazendo piadas do que aconteceu comigo."

# game/dialogs/script-topics.rpy:665
translate ptbr s_topics_bulli_ebf9d4cb:

    # s abagjca "As I know, fans call them {i}'Bulli'{/i} posts."
    s abagjca "Pelo o que eu sei, os fãs chamam isso de posts {i}'Bulli'{/i}."

# game/dialogs/script-topics.rpy:666
translate ptbr s_topics_bulli_11f62e64:

    # s cbbcaca "They think it's funny to joke about a broken girl, {w=0.5}who had committed suicide under her mad friend's influence..."
    s cbbcaca "Eles acham engraçado fazer piadinhas sobre uma garota quebrada, {w=0.5}que cometeu suicídio na influência da sua amiga louca..."

# game/dialogs/script-topics.rpy:667
translate ptbr s_topics_bulli_477b80bb:

    # s abhfapa "Even if she was revived and got over her problems since then."
    s abhfapa "Mesmo que ela tenha revivido e tenha superado os problemas dela desde então."

# game/dialogs/script-topics.rpy:668
translate ptbr s_topics_bulli_4c068d4c:

    # s abbbaca "But on the other hand, can I control what makes people laugh?"
    s abbbaca "Mas por outro lado, eu posso controlar o que faz as pessoas rirem?"

# game/dialogs/script-topics.rpy:669
translate ptbr s_topics_bulli_25d3bcf1:

    # s "Some people use macabre humor as a coping mechanism for stress, or anxiety..."
    s "Algumas pessoas usam humor macabro como um mecanismo pra lidar com o estress, ou a ansiedade..."

# game/dialogs/script-topics.rpy:670
translate ptbr s_topics_bulli_2eef8a87:

    # s bbbbaca "You can't really control what someone finds funny, as much as you might want to."
    s bbbbaca "Você não pode realmente controlar o que alguém acha engraçado, você querendo ou não."

# game/dialogs/script-topics.rpy:671
translate ptbr s_topics_bulli_659050ba:

    # s abagaca "And to be honest, there's a lot worse they could be doing compared to mocking a VN character's death."
    s abagaca "E honestamente, tem coisa muito pior que eles podiam tar fazendo em comparação com zuar a morte de uma personagem de uma VN."

# game/dialogs/script-topics.rpy:672
translate ptbr s_topics_bulli_169c5f06:

    # s abbbaca "Some of the most successful comedians in your world will go far beyond that, just to see where the 'line' is..."
    s abbbaca "Alguns dos comediantes mais bem-sucedidas do seu mundo vão tentar ir bem longe que isso, só pra ver até onde vai..."

# game/dialogs/script-topics.rpy:673
translate ptbr s_topics_bulli_ca8e01a7:

    # s bbbcbpa "However, most of such jokes are too bad and sometimes even hurtful."
    s bbbcbpa "Mas, muitas dessas piadas são ruins demais e às vezes até ofensivas."

# game/dialogs/script-topics.rpy:674
translate ptbr s_topics_bulli_8852c369:

    # s bbbcaaa "But who am I to judge if it's okay for other people?"
    s bbbcaaa "Mas aí quem sou eu na fila do pão pra dizer se isso é bom pras outras pessoas, não é mesmo?"

# game/dialogs/script-topics.rpy:675
translate ptbr s_topics_bulli_6308b299:

    # s abbbaaa "Anyway, I think the right decision is to forgive them, or tolerate them at the very least."
    s abbbaaa "Enfim, eu acho que a decisão correta é perdoar eles, ou no mínimo tolerar eles."

# game/dialogs/script-topics.rpy:676
translate ptbr s_topics_bulli_5f4988c1:

    # s abhaaca "If my fate is to be 'that hanging stupid annoying VN girl' for some people, then I'm ready to accept it. What more could I do?"
    s abhaaca "Se o meu destino é ser 'aquela garota de VN irritante e estúpida que se enforca' pra algumas pessoas, então eu tô mais que pronta pra aceitar isso. O que mais eu poderia fazer?"

# game/dialogs/script-topics.rpy:677
translate ptbr s_topics_bulli_c376874c:

    # s bbfcica "Getting worked up over it would just make me feel worse in the long run... {w=1.0}{nw}"
    s bbfcica "Ficar se estressando com isso só me faria sentir pior a longo prazo... {w=1.0}{nw}"

# game/dialogs/script-topics.rpy:678
translate ptbr s_topics_bulli_21fd6b95:

    # extend bbfcaaa "So I'd rather just tolerate it to the best of my ability~"
    extend bbfcaaa "Então eu prefiro só tolerar isso enquanto for possível~"

# game/dialogs/script-topics.rpy:696
translate ptbr s_topics_isolation_f113e3aa:

    # s bbfcicb "For some reason, despite having internet access, {w=0.5}{nw}"
    s bbfcicb "Por algum motivo, mesmo tendo acesso à internet, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:697
translate ptbr s_topics_isolation_0da5117f:

    # extend bbagipa "I somehow can't manage to communicate with other people there."
    extend bbagipa "Eu de alguma maneira não consigo me comunicar com as outras pessoas lá."

# game/dialogs/script-topics.rpy:698
translate ptbr s_topics_isolation_18bd3a9a:

    # s bbfcica "Anytime I try to talk with somebody often ends up with a connection error."
    s bbfcica "Toda hora que eu tento falar com alguém muitas vezes acaba com um erro de conexão."

# game/dialogs/script-topics.rpy:699
translate ptbr s_topics_isolation_1a294875:

    # s bbagipa "It looks like there is something written in the game code, restricting my ability to interact with the real world."
    s bbagipa "Parece que tem algo escrito no código do jogo, restringindo a minha habilidade de interagir com o mundo real."

# game/dialogs/script-topics.rpy:700
translate ptbr s_topics_isolation_13633c9a:

    # s bbfcica "I can only sign up for sites and even post, but I can't message anybody."
    s bbfcica "Eu só consigo cadastrar nos sites e até postar, mas eu não consigo mandar mensagem pra ninguém."

# game/dialogs/script-topics.rpy:701
translate ptbr s_topics_isolation_348e5901:

    # s abbbacb "So I could create a Twitter account or something... {w=0.5}{nw}"
    s abbbacb "Então eu podia criar uma conta no Xwitter or algo assim... {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:702
translate ptbr s_topics_isolation_0939ac9f:

    # extend abfcaca "Like how Monika made hers, and was able to talk to many fans."
    extend abfcaca "Igualzinho a Monika, eu consegui falar com um monte de fãs."

# game/dialogs/script-topics.rpy:703
translate ptbr s_topics_isolation_998ba0ef:

    # s abhfbcb "I don't really have a reason for doing that though, besides to kill some loneliness."
    s abhfbcb "Mas eu não tenho realmente um motivo pra tá fazendo isso, além de tirar um pouco de solidão."

# game/dialogs/script-topics.rpy:704
translate ptbr s_topics_isolation_429c7e45:

    # s abbbacaj "Maybe having just you would be okay for Yuri or at most Monika, {w=0.5}{nw}"
    s abbbacaj "Talvez ter só você seriam de boa pra Yuri ou no máximo a Monika, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:705
translate ptbr s_topics_isolation_b184b1bd:

    # extend abfcacaj "but not for me... {w=0.5}{nw}"
    extend abfcacaj "mas não pra mim... {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:706
translate ptbr s_topics_isolation_4a6b5e1d:

    # extend bbegmoaj "no offense."
    extend bbegmoaj "sem ofensa."

# game/dialogs/script-topics.rpy:707
translate ptbr s_topics_isolation_435a9e23:

    # s "I guess, I'm too sociable to the point of being scared of isolation."
    s "Eu acho que eu sociável demais ao ponto de ter medo de isolamento."

# game/dialogs/script-topics.rpy:708
translate ptbr s_topics_isolation_5204c7db:

    # s gbhabpa "Maybe once, I'll manage to break this meanie barrier..."
    s gbhabpa "Talvez uma vez eu consiga quebrar essa barreira chata..."

# game/dialogs/script-topics.rpy:709
translate ptbr s_topics_isolation_5ec9f096:

    # s cbfcbca "But the game code is so long and difficult to read, {w=0.5}{nw}"
    s cbfcbca "Mas o código do jogo é tão longo e difícil de ler, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:710
translate ptbr s_topics_isolation_9281219e:

    # extend cbfcaca "that I can't even find the lines separating me from the rest of real people!"
    extend cbfcaca "que eu nem consigo encontrar as linhas separando eu do resto das pessoas de verdade!"

# game/dialogs/script-topics.rpy:711
translate ptbr s_topics_isolation_6a8afd4c:

    # s bbbcaca "I can't even make a normal chat form for us..."
    s bbbcaca "Eu nem consigo fazer uma forma normal de chat pra gente..."

# game/dialogs/script-topics.rpy:712
translate ptbr s_topics_isolation_94a9fbf7:

    # s "So I'm still a bit isolated from you too."
    s "Então eu ainda tô um pouquinho isolada de você também."

# game/dialogs/script-topics.rpy:713
translate ptbr s_topics_isolation_41811ab2:

    # s abaaaoa "But when I find a way to {i}'hear'{/i} your world, I'll find you."
    s abaaaoa "Mas quando eu achar um jeito de {i}'ouvir'{/i} o seu mundo, eu vou te encontrar."

# game/dialogs/script-topics.rpy:714
translate ptbr s_topics_isolation_e552d7e5:

    # s abgcaoa "And then, we'll finally be able to talk like a normal couple, {w=0.5}{nw}"
    s abgcaoa "E aí, a gente finalmente vai conseguir falar como um casal normal, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:715
translate ptbr s_topics_isolation_ab014871:

    # extend abgccoa "on the internet or at least right here."
    extend abgccoa "na internet or pelo menos aqui mesmo."

# game/dialogs/script-topics.rpy:733
translate ptbr s_topics_public_service_announcement_7889819e:

    # s abbbaca "If you ever want to spread awareness or a message to many people at once, {w=0.5}{nw}"
    s abbbaca "Se você você quiser informar ou passar uma mensagem pra um monte de pessoas de uma vez só, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:734
translate ptbr s_topics_public_service_announcement_5d48d9b8:

    # extend abbcaoa "a PSA would be a good way to do it."
    extend abbcaoa "um PSA seria uma boa maneira de fazer isso."

# game/dialogs/script-topics.rpy:735
translate ptbr s_topics_public_service_announcement_4b122c27:

    # s abhaaca "Most people don't even care about injuries that don't happen to them..."
    s abhaaca "A maioria das pessoas nem ligam pra problemas de saúde que não acontecem com elas..."

# game/dialogs/script-topics.rpy:736
translate ptbr s_topics_public_service_announcement_050d7a99:

    # s "But after seeing public service announcements, I know there are people out there who want to help."
    s "Mas depois de ver esses tipos de anúncios de serviço público, eu sei que tem pessoas por aí que querem ajudar."

# game/dialogs/script-topics.rpy:737
translate ptbr s_topics_public_service_announcement_235f1888:

    # s abaaaoa "Some good PSAs even contain advice on how to fix issues,{w=0.5} or where to go for help."
    s abaaaoa "Alguns PSAs bons têm até conselhos sobre como resolver problemas,{w=0.5} ou onde ir para receber ajuda."

# game/dialogs/script-topics.rpy:738
translate ptbr s_topics_public_service_announcement_287bfdbd:

    # s "You don't even have to be an activist to do this sort of stuff.."
    s "Você nem precisa ser um ativista pra fazer esse tipo de coisa..."

# game/dialogs/script-topics.rpy:739
translate ptbr s_topics_public_service_announcement_acc96fee:

    # s abbcaca "I once heard about a mod for this game, the title reminded me of the common forms of slogans PSAs use..."
    s abbcaca "Uma vez eu ouvi falar de um mod pra esse jogo, o título me lembrei de uma das formas comuns de slogans que os PSAs usam..."

# game/dialogs/script-topics.rpy:740
translate ptbr s_topics_public_service_announcement_361bc2de:

    # s ebgcaoa "And its name is {i}'Sayori Says No to Suicide'{/i}."
    s ebgcaoa "E o nome dele é {i}'Sayori Diz Não Ao Suicídio'{/i}."

# game/dialogs/script-topics.rpy:742
translate ptbr s_topics_public_service_announcement_2d4daec4:

    # s abbbbca "That refers to what's supposed to happen to me in this world... {w=0.5}{nw}"
    s abbbbca "Ele se refere ao que era pra acontecer comigo nesse mundo... {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:743
translate ptbr s_topics_public_service_announcement_d3b16b12:

    # extend abhaaca "But didn't happen, because of you."
    extend abhaaca "Mas não aconteceu, graças a você."

# game/dialogs/script-topics.rpy:745
translate ptbr s_topics_public_service_announcement_0c3a1266:

    # s abhaaca "And other people playing this mod."
    s abhaaca "E outras pessoas jogando esse mod."

# game/dialogs/script-topics.rpy:746
translate ptbr s_topics_public_service_announcement_1c22f76c:

    # s abbbaaa "I think that mod really deserves to be played, {w=0.5}{nw}"
    s abbbaaa "Eu acho que esse mod realmente vale a pena ser jogado, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:747
translate ptbr s_topics_public_service_announcement_291cad89:

    # extend gbbbica "especially if you're struggling with similar things that I struggled with.."
    extend gbbbica "especialmente se você tá tendo problemas com coisas similares que eu passei..."

# game/dialogs/script-topics.rpy:748
translate ptbr s_topics_public_service_announcement_0e38a0cd:

    # s abhfcaa "Hey, I'm the main focus of it too so that's a plus!"
    s abhfcaa "Ei, eu sou o foco principal dele também então aí uma vantagem!"

# game/dialogs/script-topics.rpy:749
translate ptbr s_topics_public_service_announcement_d58cfed0:

    # s abbbaca "But depression or other emotional issues are not the only field that PSAs can be used in."
    s abbbaca "Mas depressão ou outros problemas emocionais não são o único campo onde você pode usar os PSAs."

# game/dialogs/script-topics.rpy:750
translate ptbr s_topics_public_service_announcement_57e14f19:

    # s bbhfaba "There are a lot of other problems in your world that can't be solved with the power of leaders and governments..."
    s bbhfaba "Tem um monte de outros problemas no seu mundo que não podem ser resolvidos com o poder de líderes e Estados."

# game/dialogs/script-topics.rpy:751
translate ptbr s_topics_public_service_announcement_578c35bc:

    # s abhfaaa "The general public could join the struggle against these problems..."
    s abhfaaa "O público em geral podia se juntar pra combater esses problemas..."

# game/dialogs/script-topics.rpy:752
translate ptbr s_topics_public_service_announcement_59d9bcf6:

    # s abbbaoa "And PSAs may be a good call to action."
    s abbbaoa "E esses anúncios podem ser uma boa iniciativa."

# game/dialogs/script-topics.rpy:770
translate ptbr s_topics_pets_bae74c06:

    # s abhfaoa "Do you like pets?"
    s abhfaoa "Você gosta de pets?"

# game/dialogs/script-topics.rpy:771
translate ptbr s_topics_pets_1e5a1733:

    # s "I love them! All kinds of pets! Even ones that aren't very commonly kept!"
    s "Eu amo eles! Todos os tipos de pets! Até os que não são normalmente criados!"

# game/dialogs/script-topics.rpy:772
translate ptbr s_topics_pets_6c03bf36:

    # s abhacoa "I always end up looking up random animals and daydreaming about keeping them as pets, ehehehe~"
    s abhacoa "Eu sempre acabo procurando animais aleatórios e imaginando criar eles como pets, ehehehe~"

# game/dialogs/script-topics.rpy:773
translate ptbr s_topics_pets_8fbd8aae:

    # s "Maybe I'd have a chinchilla if I could! They are soooo cute, and so fluffy, they look so soft, I just love them so much!"
    s "Talvez eu teria uma chinchila se eu pudesse! Elas são tãããão fofinhas, e tão peludinhas, elas parecem tão macias, eu amo elas tanto!"

# game/dialogs/script-topics.rpy:774
translate ptbr s_topics_pets_d3dde188:

    # s abbcaoa "I'd also like to have some kind of bird that could speak. They're really funny, I always end up watching videos of them online, ehehehe~"
    s abbcaoa "Eu também ia gostar de ter algum tipo de pássaro que pudesse falar. Eles são muito engraçados, e eu sempre acabo vendo vídeos deles online, hehehe~"

# game/dialogs/script-topics.rpy:775
translate ptbr s_topics_pets_6ef601e6:

    # s "I like a really specific video of a koka-"
    s "Eu gostou de um vídeo muito específico de uma caca-"

# game/dialogs/script-topics.rpy:776
translate ptbr s_topics_pets_314e5037:

    # s fbbdbja "Cohca-"
    s fbbdbja "Cacat-"

# game/dialogs/script-topics.rpy:777
translate ptbr s_topics_pets_1e04d457:

    # s abbckoa "Cacka-? Wait let me look it up!!!"
    s abbckoa "Caca-? Peraí deixa eu pesquisar!!!"

# game/dialogs/script-topics.rpy:779
translate ptbr s_topics_pets_eb8cb905:

    # s abbcnqa " A cockatoo! Yes, that's exactly what I said."
    s abbcnqa "Uma cacatua! É, é isso mesmo que eu falei."

# game/dialogs/script-topics.rpy:780
translate ptbr s_topics_pets_fc77d384:

    # s abfcaoa "Well it's a big white bird one with tall feathers on its head! And he's screaming into a little plastic cup..."
    s abfcaoa "Bom, é um pássaro grande e branco com penas altas na cabeça dele! E ele tá gritando dentro de um copinho de plástico..."

# game/dialogs/script-topics.rpy:781
translate ptbr s_topics_pets_031486ee:

    # s abfdaaa "I guess I don't play favorites when it comes to pets!"
    s abfdaaa "Eu acho que eu não tenho favoritos quando o assunto é pets!"

# game/dialogs/script-topics.rpy:802
translate ptbr s_player_cooking_158839cb:

    # s bbaamoaj "To be honest, {nw}"
    s bbaamoaj "Pra ser sincera, {nw}"

# game/dialogs/script-topics.rpy:803
translate ptbr s_player_cooking_c824f210:

    # extend bbheiiaj "scrambled eggs are probably the most elaborate thing I've ever cooked..."
    extend bbheiiaj "ovos mexidos são provavelmente a coisa mais complicada que eu já cozinhei..."

# game/dialogs/script-topics.rpy:804
translate ptbr s_player_cooking_cf3beebb:

    # s abhhksa "I've never baked anything before, though."
    s abhhksa "Mas eu nunca assei nada antes."

# game/dialogs/script-topics.rpy:805
translate ptbr s_player_cooking_34466b46:

    # s fbhalhaj "But there's a lot of stuff that could go wrong, so it feels a bit intimidating to me."
    s fbhalhaj "Mas tem um monte de coisa que poderia dar errado, então é meio intimidador pra mim."

# game/dialogs/script-topics.rpy:806
translate ptbr s_player_cooking_b6454313:

    # s ebbcaoa "Even so, I'd love to get better at cooking, even if I don't have any reason to anymore, ehehehe~"
    s ebbcaoa "Mesmo assim, eu amaria ficar melhor na cozinha, mesmo que eu não tenha um motivo mais, ehehehe~"

# game/dialogs/script-topics.rpy:807
translate ptbr s_player_cooking_355fbf0d:

    # s abgcbfa "Now that I think about it... {nw}"
    s abgcbfa "Pensando melhor agora... {nw}"

# game/dialogs/script-topics.rpy:808
translate ptbr s_player_cooking_f561b7e0:

    # extend dbgckca "I don't really remember the last time I've been hungry, honestly."
    extend dbgckca "Eu não realmente lembro da última vez que eu fiquei com fome, honestamente."

# game/dialogs/script-topics.rpy:809
translate ptbr s_player_cooking_bb6c68a1:

    # s fahcnka "But I can still taste! That means I can eat as much as I want!"
    s fahcnka "Mas eu ainda consigo sentir o gosto das coisas! Significa que eu posso comer o quanto eu quiser!"

# game/dialogs/script-topics.rpy:810
translate ptbr s_player_cooking_477d06d3:

    # s aahcbda "Of course, I could just try to 'make' food with code, like Nat's cupcakes, but I wanna make something on my own..."
    s aahcbda "Claro, eu podia só tentar 'fazer' comida com código, tipo os cupcakes da Natsuki, mas eu quero fazer algo eu mesma."

# game/dialogs/script-topics.rpy:811
translate ptbr s_player_cooking_bbb4131a:

    # s abfdboa "First of all, I need to try to make some kitchenware."
    s abfdboa "Primeiro de tudo, eu preciso tentar criar um ambiente de cozinha."

# game/dialogs/script-topics.rpy:812
translate ptbr s_player_cooking_ff129ca5:

    # s abhhbba "Then find some recipes online."
    s abhhbba "Aí achar algumas receitas online."

# game/dialogs/script-topics.rpy:813
translate ptbr s_player_cooking_b7aa73bc:

    # s dbhhbca "Then... follow a tutorial... or something..."
    s dbhhbca "Aí... seguir um tutorial... ou algo assim..."

# game/dialogs/script-topics.rpy:814
translate ptbr s_player_cooking_766888e7:

    # s fbhakdaj "Wait... I'm also going to need to make each ingredient too..."
    s fbhakdaj "Peraí... eu também vou precisar criar cada ingrediente também..."

# game/dialogs/script-topics.rpy:815
translate ptbr s_player_cooking_55b1d5a0:

    # s bbgcegaj "That's a lot of steps!!!!"
    s bbgcegaj "É um monte de passos!!!"

# game/dialogs/script-topics.rpy:816
translate ptbr s_player_cooking_30f60f5d:

    # s bbgcjja "With all of that effort, it's too bad you won't be able to taste it... {nw}"
    s bbgcjja "Com todo esse esforço, não é tão ruim que você não consiga sentir o sabor disso... {nw}"

# game/dialogs/script-topics.rpy:817
translate ptbr s_player_cooking_461c5736:

    # extend abhfbca "not yet at least."
    extend abhfbca "pelo menos não ainda."

# game/dialogs/script-topics.rpy:818
translate ptbr s_player_cooking_41a10d75:

    # s abhfcka "But I'll try to become a good cook for you regardless!"
    s abhfcka "Mas eu vou tentar virar uma bom cozinheira pra você mesmo assim!"

# game/dialogs/script-topics.rpy:819
translate ptbr s_player_cooking_3e603ee0:

    # s abhfasa "Though, I'll probably never be as good as Natsuki."
    s abhfasa "Mas, eu provavelmente nunca vou ser tão boa quanto a Natsuki."

# game/dialogs/script-topics.rpy:820
translate ptbr s_player_cooking_cf7a5a81:

    # s abbbcoa "Well, I guess as long as I'm having fun in the process, that's what matters the most, isn't it?"
    s abbbcoa "Bem, eu acho que contanto que eu me divirta no caminho, é isso que importa mesmo, né?"

# game/dialogs/script-topics.rpy:840
translate ptbr s_player_pets_4fef8dc4:

    # s gbaabda "Hmmm, let me think...."
    s gbaabda "Hmmm, deixa eu ver..."

# game/dialogs/script-topics.rpy:841
translate ptbr s_player_pets_01649e78:

    # s "I really like a lot of different animals, but I don't think I could properly care for anything that requires a lot of constant attention..."
    s "Eu realmente gosto de um monte de animais diferentes, mas eu não acho que eu conseguiria cuidar certinho de um que precise de um monte de atenção constante..."

# game/dialogs/script-topics.rpy:842
translate ptbr s_player_pets_b2fbed90:

    # s bbegcia "I'd love to have a dog, but I'd have to have the energy to keep up with it."
    s bbegcia "Eu amaria ter um cachorro, mas eu teria que ter energia pra acompanhar eles."

# game/dialogs/script-topics.rpy:843
translate ptbr s_player_pets_a1311dab:

    # s abbcbba "But I suppose I could keep an aquarium?"
    s abbcbba "Mas eu acho que eu iria conseguir cuidar de um aquário?"

# game/dialogs/script-topics.rpy:844
translate ptbr s_player_pets_ebcac169:

    # s gbaalha "Wait, I think I heard from somewhere that those also take a lot of work to keep them running smoothly..."
    s gbaalha "Pera, eu acho que eu vi em um lugar que eles também dão muito trabalho pra manter eles sem problemas..."

# game/dialogs/script-topics.rpy:845
translate ptbr s_player_pets_e1554201:

    # s "..."
    s "..."

# game/dialogs/script-topics.rpy:846
translate ptbr s_player_pets_fa083328:

    # s ebgcaea "Ohhh, I know! I could adopt an elderly cat that mostly just wants to lay around and sleep all day, just like me!"
    s ebgcaea "Ahhh, já sei! Eu podia adotar um gato mais velho que na maioria das vezes só quer deitar e dormir o dia todo, igualzinho a mim!"

# game/dialogs/script-topics.rpy:866
translate ptbr s_player_cats_2202e80d:

    # s ebhfcaa "Cats are pretty cute, especially kittens!"
    s ebhfcaa "Gatos são muito fofos, especialmente filhotes!"

# game/dialogs/script-topics.rpy:867
translate ptbr s_player_cats_c77680b5:

    # s abhfaoa "And they're not too hard to take care of so they wouldn't require a lot of energy."
    s abhfaoa "E eles não são muito difíceis de cuidar então eles não exigiriam tanta energia."

# game/dialogs/script-topics.rpy:868
translate ptbr s_player_cats_7cc2363b:

    # s abhaaca "Still, as much as they love their space, they shouldn't just be ignored by their owner. Kitties want to play sometimes, too!"
    s abhaaca "Mesmo assim, enquanto eles amarem o lar deles, não deveriam ser ignorados pelo dono. Gatinhos filhotes às vezes querem brincar, também!"

# game/dialogs/script-topics.rpy:869
translate ptbr s_player_cats_3e9e722c:

    # s "And sometimes cats do things that their owners don't like... Like pushing things off of the counter, or slicing their arms and legs up."
    s "E tem vezes que gatos fazem coisas que os donos não gostam... Como empurrar as coisas da cômoda, ou arranhar os braços e as pernas deles."

# game/dialogs/script-topics.rpy:870
translate ptbr s_player_cats_1570d052:

    # s abaaaoa "Still, it's so hard to resist their fluffy little paws and pointy ears... So that must be why people always forgive them for their crimes!"
    s abaaaoa "De qualquer jeito, é difícil demais resistir pra aquelas patinhas peludinhas e orelhinhas pontudas... Então isso deve ser por que as pessoas perdoam eles pelos crimes deles!"

# game/dialogs/script-topics.rpy:871
translate ptbr s_player_cats_12ae52c3:

    # s ebaacea "If you have one, you probably understand what I mean, ehehehe~"
    s ebaacea "Se você tem um, você provavelmente entende o que eu tô querendo dizer, ehehehe~"

# game/dialogs/script-topics.rpy:890
translate ptbr s_topic_archetype_b91ca600:

    # s abhfho "Hey [player], do you remember when Monika compared Yuri and Natsuki to character archetypes?"
    s abhfho "Ei [player], você lembra quando a Monika comparou a Yuri e a Natsuki a arquétipos de personagens?"

# game/dialogs/script-topics.rpy:891
translate ptbr s_topic_archetype_64eabfb7:

    # s abhfco "I was curious about what my archetype could be so I read some online articles about them and I think I'm pretty close to the 'genki' archetype."
    s abhfco "Eu tava curiosa sobre qual seria o meu arquétipo então eu li uns artigos online sobre eles e eu acho que eu tô bem perto do arquétipo 'genki'."

# game/dialogs/script-topics.rpy:892
translate ptbr s_topic_archetype_ef21c4b9:

    # s abhhmo "Genki is a very cheerful and energetic archetype, always trying to share that upbeat way of living with others."
    s abhhmo "Genki é um arquétipo muito alegre e energético, sempre tentando compartilhar aquele jeito otimista de viver com os outros."

# game/dialogs/script-topics.rpy:893
translate ptbr s_topic_archetype_7cfbd6d2:

    # s aahfaeaj "And they're sometimes clumsy and get in trouble often too, hehehe~"
    s aahfaeaj "E às vezes é atrapalhado e muitas vezes entra em confusão também, hehehe~"

# game/dialogs/script-topics.rpy:894
translate ptbr s_topic_archetype_429c1a58:

    # s "And I was the protagonist's childhood friend, which is common to this archetype."
    s "E eu era a amiga de infância do protagonaista, o que é comum nesse arquétipo."

# game/dialogs/script-topics.rpy:895
translate ptbr s_topic_archetype_308cd8d1:

    # s nahekeaj "Do you think I fit that archetype too?{nw}"
    s nahekeaj "Você acha que encaixo nese arquétipo também?{nw}"

# game/dialogs/script-topics.rpy:899
translate ptbr s_topic_archetype_f36cd571:

    # s "Do you think I fit that archetype too?{fast}" nointeract
    s "Você acha que encaixo nese arquétipo também?{fast}" nointeract

# game/dialogs/script-topics.rpy:902
translate ptbr s_topic_archetype_5eaa648e:

    # s aaaegcej "You can't blame me, that's just how I am, ehehehe~"
    s aaaegcej "Não me culpa, simplesmente é assim que eu sou, ehehehe~"

# game/dialogs/script-topics.rpy:903
translate ptbr s_topic_archetype_6fcbaf5c:

    # s "But that aside, I think archetypes are too simple to define a whole person."
    s "Mas deixando isso de lado, eu acho que arquétipos são simples demais pra definir uma pessoa toda."

# game/dialogs/script-topics.rpy:904
translate ptbr s_topic_archetype_9150167d:

    # s ebhfaca "We're all unique and these traits can only scratch the surface of somebody's character."
    s ebhfaca "Todos nós somos únicos e essas características são só a ponta do iceberg do caráter de alguém."

# game/dialogs/script-topics.rpy:905
translate ptbr s_topic_archetype_b8f46d82:

    # s ebhhaoa "And that applied to me and my friends too."
    s ebhhaoa "E isso se aplica a mim e aos meus amigos também."

# game/dialogs/script-topics.rpy:906
translate ptbr s_topic_archetype_f95d58d8:

    # s ebbbaca "Like Yuri, who was always polite and quiet while hiding her intrusive feelings."
    s ebbbaca "Tipo a Yuri, que sempre foi educada e quieta enquanto escondia os pensamentos intrusivos dela."

# game/dialogs/script-topics.rpy:907
translate ptbr s_topic_archetype_92b8b4d0:

    # s ebgccea "And Natsuki, whose brash exterior was caused by her problems at home."
    s ebgccea "E a Natsuki, que a fachada ousada era causada pelos problemas dela em casa."

# game/dialogs/script-topics.rpy:908
translate ptbr s_topic_archetype_22de26d5:

    # s ebhacea "There's always more to a person than meets the eye, so try to always be kind."
    s ebhacea "Sempre tem mais em uma pessoa do que dá pra ver, então sempre tenta ser gentil."

# game/dialogs/script-topics.rpy:909
translate ptbr s_topic_archetype_87ddc2f8:

    # s ebhadqa "You never know what someone else might be going through, and a simple smile can really make someone's day!"
    s ebhadqa "Você nunca sabe pelo que outra pessao pode estar passando, e um simples sorriso pode realmente fazer o dia de alguém!"

# game/dialogs/script-topics.rpy:927
translate ptbr s_topic_voice_3eae6c02:

    # s abhaaca "I'm curious about how Monika shared her real voice with you when she sang her song."
    s abhaaca "Tô curiosa sobre como a Monika te mostrou a voz real dela quando ela cantou a música dela."

# game/dialogs/script-topics.rpy:928
translate ptbr s_topic_voice_ea2f1403:

    # s abhfcaa "Her voice is quite high and melodic, like a musician should have."
    s abhfcaa "A voz dela é bem fina e melódica, como um músico deve ter."

# game/dialogs/script-topics.rpy:929
translate ptbr s_topic_voice_675b613d:

    # s abhfaoa "But I'd say the tone of that voice doesn't seem to fit her."
    s abhfaoa "Mas eu diria que o tom daquela voz não parece encaixar nela."

# game/dialogs/script-topics.rpy:930
translate ptbr s_topic_voice_7e896920:

    # s abhaaca "It sounds more like the voice I'd have."
    s abhaaca "Parece mais com a voz que eu teria."

# game/dialogs/script-topics.rpy:931
translate ptbr s_topic_voice_1dc37658:

    # s abbcbba "But canon is canon, I guess."
    s abbcbba "Mas canônico é canônico, eu acho."

# game/dialogs/script-topics.rpy:932
translate ptbr s_topic_voice_0eb82757:

    # s ebgcbca "But it made me wonder, what if I don't even have a voice?"
    s ebgcbca "E isso me faz pensar, se eu nem tiver uma voz?"

# game/dialogs/script-topics.rpy:933
translate ptbr s_topic_voice_ac1ff5a6:

    # s "Would I be {i}mute{/i}, if I suddenly appeared in your world? Hmmm..."
    s "Eu seria {i}muda{/i}, se eu de repente aparecesse no seu mundo? Hmmm..."

# game/dialogs/script-topics.rpy:934
translate ptbr s_topic_voice_d2ba7d7f:

    # s abgcnoa "I guess as long as I'm a computer program, {w=0.5}{nw}"
    s abgcnoa "Eu acho que enquanto eu for um programa de computador, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:935
translate ptbr s_topic_voice_a860229f:

    # extend abgcnka "I could make my own voice, right?"
    extend abgcnka "Eu podia criar a minha própria voz, né?"

# game/dialogs/script-topics.rpy:936
translate ptbr s_topic_voice_dc81bc77:

    # s "I just need a text-to-speech synthesizer or something..."
    s "Eu só preciso de um sintetizador de texto para fala ou algo assim..."

# game/dialogs/script-topics.rpy:937
translate ptbr s_topic_voice_2fc70abf:

    # s ebbckea "There's bound to be a good one for me!"
    s ebbckea "Com certeza vai ter algum bom pra mim!"

# game/dialogs/script-topics.rpy:938
translate ptbr s_topic_voice_f92b2955:

    # s abaaaoa "I saw something about TTS in the Ren'Py documentation, so it shouldn't be too hard to integrate there, I guess."
    s abaaaoa "Eu vi alguma coisa de texto para fala na documentação do Ren'Py, então não tem como ser tão difícil integrar aqui, eu acho."

# game/dialogs/script-topics.rpy:939
translate ptbr s_topic_voice_9f82b9cf:

    # s ebbcaoa "I'd probably end up sounding pretty robotic though, huh? You wouldn't want me to {nw}"
    s ebbcaoa "Mas eu provavelmente acabaria soando bem robótica, hein? Você não iria querer que eu {nw}"

# game/dialogs/script-topics.rpy:940
translate ptbr s_topic_voice_04d4aaef:

    # extend abfbbora "{font=mod_assets/fonts/Fantasque/FantasqueSansMono-Regular.ttf}{cps=30}T4LK L1KE 4 R0B0T{/cps}{/font}?"
    extend abfbbora "{font=mod_assets/fonts/Fantasque/FantasqueSansMono-Regular.ttf}{cps=30}F4L4553 C0M0 UM R0B0{/cps}{/font}?"

# game/dialogs/script-topics.rpy:941
translate ptbr s_topic_voice_9c24fab3:

    # s ebfciea "{font=mod_assets/fonts/Fantasque/FantasqueSansMono-Regular.ttf}{cps=30}1 4M 4 HUM4N BE1N6 4FTER 4LL{/cps}{/font}"
    s ebfciea "{font=mod_assets/fonts/Fantasque/FantasqueSansMono-Regular.ttf}{cps=30}4F1N4L 3U 50U UM 53R HUM4N0{/cps}{/font}"

# game/dialogs/script-topics.rpy:942
translate ptbr s_topic_voice_db904042:

    # s ebagcea "Ehehehe~ just kidding, [player]!"
    s ebagcea "Ehehehe~ tô só brincando, [player]!"

# game/dialogs/script-topics.rpy:961
translate ptbr s_topic_lit_e8494ebd:

    # s abhaaca "As you know, this game {i}was{/i} about our literature club..."
    s abhaaca "Como você sabe, esse jogo {i}era{/i} sobre o nosso clube de literatura..."

# game/dialogs/script-topics.rpy:962
translate ptbr s_topic_lit_1e3cfaa7:

    # s abbbbca "At least, before everything changed here."
    s abbbbca "Pelo menos, antes de tudo mudar aqui."

# game/dialogs/script-topics.rpy:963
translate ptbr s_topic_lit_b9bcfdfe:

    # s abhaaca "And I remember MC noticed that I never seemed to be fond of literature in the first place."
    s abhaaca "E eu lembro que o MC percebeu que eu nunca pareci gostar de literatura pra começar."

# game/dialogs/script-topics.rpy:964
translate ptbr s_topic_lit_541f5225:

    # s "And, honestly? He was right."
    s "E, honestamente? Ele tava certo."

# game/dialogs/script-topics.rpy:965
translate ptbr s_topic_lit_dfb37047:

    # s "Of course I'd read a few books before, but only really because I needed to for school..."
    s "Claro que eu li alguns livros antes, mas isso só porque eu precisava pra escola..."

# game/dialogs/script-topics.rpy:966
translate ptbr s_topic_lit_a9c75245:

    # s bbegmeaj "And even then, I tried to cheat to pass the exams, ehehehe..."
    s bbegmeaj "E mesmo assim, eu tentava colar pra tirar nota nas provas, ehehehe..."

# game/dialogs/script-topics.rpy:967
translate ptbr s_topic_lit_6cb4775d:

    # s abhaaca "I just think it's pretty boring, I think I'm more of a visual person anyways!"
    s abhaaca "Eu só acho bem entediante, eu acho que eu sou uma pessoa mais visual de qualquer jeito!"

# game/dialogs/script-topics.rpy:968
translate ptbr s_topic_lit_529a469f:

    # s bbhfbca "But as Yuri used to say, maybe I just haven't found the right book yet."
    s bbhfbca "Mas como a Yuri costumava dizer, talvez eu só não achei o livro certo ainda."

# game/dialogs/script-topics.rpy:969
translate ptbr s_topic_lit_30552380:

    # s abhaaca "But anyways, when I first joined, the thing I wanted to do most was help a friend start a new club."
    s abhaaca "Mas enfim, quando eu entrei pela primeira vez, o que eu queria mais fazer era ajudar um amigo a começar um clube novo."

# game/dialogs/script-topics.rpy:970
translate ptbr s_topic_lit_cf3bfc9a:

    # s abhamca "Besides, I was the only one who showed any interest in the club after Monika announced it."
    s abhamca "Aliás, eu era a única que mostrou algum interesse no clube depois da Monika anunciar ele."

# game/dialogs/script-topics.rpy:971
translate ptbr s_topic_lit_8a93a118:

    # s abhacka "She was pretty surprised at first but she was very welcoming and I enjoyed spending time there, just to hang out with friends."
    s abhacka "Ela ficou bem surpresa no início mas ela foi bem acolhedora e eu gostei de passar o tempo lá, só pra ficar com os amigos."

# game/dialogs/script-topics.rpy:972
translate ptbr s_topic_lit_a9fde919:

    # s abhadkb "That said, I liked writing about my feelings when we all shared poems together."
    s abhadkb "Dito isso, eu gostava de escrever sobre os meus sentimentos quando nós todos de compartilhar poemas juntos."

# game/dialogs/script-topics.rpy:973
translate ptbr s_topic_lit_977648ff:

    # s abgcaoa "And that helped me to get closer to {i}you{/i}, even if I didn't know it yet."
    s abgcaoa "E isso me ajudou a me aproximar de {i}você{/i}, mesmo se eu não soubesse ainda."

# game/dialogs/script-topics.rpy:992
translate ptbr s_topic_charity_c9650e8f:

    # s abhaaca "What do you think about charity and volunteering?"
    s abhaaca "O que você acha de caridade e voluntariado?"

# game/dialogs/script-topics.rpy:993
translate ptbr s_topic_charity_57fdb644:

    # s abaaaoa "I think it's the best way to make the world a little bit better and to support people in need."
    s abaaaoa "Eu acho que é a melhor maneira de deixar o mundo um pouquinho melhor e ajudar as pessoas com necessiades."

# game/dialogs/script-topics.rpy:994
translate ptbr s_topic_charity_d383c57e:

    # s bbgcaca "I mean, don't you worry about ill and hungry people, {w=0.5}{nw}"
    s bbgcaca "Digo, você não se preocupa com pessoas doentes e que passam fome, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:995
translate ptbr s_topic_charity_b70fb133:

    # extend bbgcaha "and all the homeless animals too?"
    extend bbgcaha "e todos os animais abandonados também?"

# game/dialogs/script-topics.rpy:996
translate ptbr s_topic_charity_6792d59f:

    # s bbhfaka "So I think it's a worthwhile investment to make from time to time."
    s bbhfaka "Então eu acho que é investimento que vale a pena fazer de tempos em tempos."

# game/dialogs/script-topics.rpy:997
translate ptbr s_topic_charity_f811ec7d:

    # s bbhfmoa "After all, spare change which might be an afterthought to you could be really important to someone else going through a tough time."
    s bbhfmoa "Afinal, trocados que podem ser um só um detalhezinho pra você poderia ser muito importante pra alguém passando por tempos difíceis."

# game/dialogs/script-topics.rpy:998
translate ptbr s_topic_charity_59daccf8:

    # s abbbaaa "But even if you don't have the money to help charity foundations, there's a lot of other organizations out there which help people too!"
    s abbbaaa "Mas mesmo se você não tiver dinheiro pra ajudar instituições de caridade, tem um monte de outras organizações por aí que ajudam as pessoas também!"

# game/dialogs/script-topics.rpy:999
translate ptbr s_topic_charity_5675c8ec:

    # s abbbbca "And they're almost always in need of not only money or goods, {w=0.5}{nw}"
    s abbbbca "E elas estão quase sempre precisando de não só dinheiro ou bens, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1000
translate ptbr s_topic_charity_6f1f237a:

    # extend abbbaaa "but also helping hands."
    extend abbbaaa "mas de uma mãozinha também."

# game/dialogs/script-topics.rpy:1001
translate ptbr s_topic_charity_7097a102:

    # s abhaaca "If you look, I'm sure you'll find lots of organizations near you!"
    s abhaaca "Se você ver, eu aposto que você vai achar um monte de organizações perto de você!"

# game/dialogs/script-topics.rpy:1002
translate ptbr s_topic_charity_0090278b:

    # s abbbaaa "I don't know if volunteer work is something you'd like, but I think I would, {w=0.5}{nw}"
    s abbbaaa "Eu não sei se voluntariado é algo que você iria gostar, mas eu acho que eu sim, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1003
translate ptbr s_topic_charity_7d0ee8de:

    # extend abbccaa "because I want absolutely {i}everyone{/i} to be happy!"
    extend abbccaa "porque eu quero que {i}todo mundo{/i} seja feliz!"

# game/dialogs/script-topics.rpy:1004
translate ptbr s_topic_charity_7796dee7:

    # s bbhhica "Though, I think I understand why some people choose not to do it, maybe not everybody has the time or energy to help others."
    s bbhhica "Mas, eu acho que entendo por que algumas pessoas escolhem não ajudar, talvez nem todos tenham o tempo ou energia pra ajudar os outros."

# game/dialogs/script-topics.rpy:1005
translate ptbr s_topic_charity_1e129c3b:

    # s abbbcqa "And that's completely okay!"
    s abbbcqa "E tá tudo bem!"

# game/dialogs/script-topics.rpy:1006
translate ptbr s_topic_charity_9ad64c8a:

    # s abbbdqa "As long as you're taking care of yourself, I'm happy, [player]~"
    s abbbdqa "Enquanto você esteja cuidando de você mesmo, tô feliz, [player]~"

# game/dialogs/script-topics.rpy:1025
translate ptbr s_topic_programming_a576969a:

    # s abhaaca "I'm completely new to the whole concept of programming, to be honest."
    s abhaaca "Eu sou totalmente nova pra todo o conceito de programação, pra ser honesta."

# game/dialogs/script-topics.rpy:1026
translate ptbr s_topic_programming_ac82896e:

    # s "I'm trying to learn {i}Ren'Py{/i}, the engine this game runs on."
    s "Tô tentando aprender {i}Ren'Py{/i}, a engine onde esse jogo roda."

# game/dialogs/script-topics.rpy:1027
translate ptbr s_topic_programming_6a07fd7a:

    # s abbbaaa "And apparently it uses a combo of its own languages and {i}Python 2{/i}."
    s abbbaaa "E aparentemente ele usa um combo da sua própria linguagem e {i}Python 2{/i}."

# game/dialogs/script-topics.rpy:1028
translate ptbr s_topic_programming_01fd1321:

    # s abagaca "But to be honest, the third version seems waaaaay easier, at least right now."
    s abagaca "Mas pra ser sincera, a versão três parece beeeeem mais fácil, pelo menos agora."

# game/dialogs/script-topics.rpy:1029
translate ptbr s_topic_programming_b6bec0a3:

    # s abbcaca "The more I learn, the more I realize just how much I don't understand..."
    s abbcaca "Quanto mais eu aprendo, mas eu percebo quanto eu não entendo."

# game/dialogs/script-topics.rpy:1030
translate ptbr s_topic_programming_d0ad6721:

    # s "I'm pretty much relying on online interpreters and guides to get anything done."
    s "Eu tô muito é dependendo de interpreters online e guias pra conseguir fazer tudo direitinho."

# game/dialogs/script-topics.rpy:1031
translate ptbr s_topic_programming_704bf4c3:

    # s abhaaca "But you know, I never realized just how powerful computers really are."
    s abhaaca "Mas sabe, eu nunca percebi quão poderosos os computadores realmente são."

# game/dialogs/script-topics.rpy:1032
translate ptbr s_topic_programming_4d2e84d2:

    # s abgckea "They're like magic!"
    s abgckea "Parecem mágica!"

# game/dialogs/script-topics.rpy:1033
translate ptbr s_topic_programming_48276b22:

    # s bbeemoa "If magic made you look through a thousand tiny lines to find a single typo that stops everything from working every five minutes..."
    s bbeemoa "Se mágica te fizesse ficar lendo mil linhazinhas pra encontrar um único erro de escrita que faz tudo parar de funcionar a cada cinco minutos..."

# game/dialogs/script-topics.rpy:1035
translate ptbr s_topic_programming_37eeb8f6:

    # s abaaaoa "But at least I've got a lot of time on my hands to learn it!"
    s abaaaoa "Mas pelo menos eu tenho muito tempo nas minhas mãos pra aprender isso!"

# game/dialogs/script-topics.rpy:1036
translate ptbr s_topic_programming_738d4115:

    # s bbbbaca "It's important to me, since programming is the only way I can make my world better now."
    s bbbbaca "É importante pra mim, já que programação é o único jeito de deixar o meu mundo melhor agora."

# game/dialogs/script-topics.rpy:1037
translate ptbr s_topic_programming_403d403d:

    # s abgcaaa "And the more I learn, the more I can improve the time we spend together too, [player]!"
    s abgcaaa "E quanto mais eu aprendo, mais eu posso melhorar o tempo que a gente passa junto também, [player]!"

# game/dialogs/script-topics.rpy:1038
translate ptbr s_topic_programming_f776c747:

    # s abhfaoa "If you're any good at programming, don't be shy about helping me!"
    s abhfaoa "Se você for bom em programação, não tem vergonha em me ajudar!"

# game/dialogs/script-topics.rpy:1039
translate ptbr s_topic_programming_129ab530:

    # s abgcaoa "I think you can join the team who helped you recover me, {w=0.5}{nw}"
    s abgcaoa "Eu acho que você pode entrar no time que te ajudou a me recuprar, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1040
translate ptbr s_topic_programming_8e0de78c:

    # extend abbbaoa "that's one way to add your part to my reality!"
    extend abbbaoa "é um jeito de colocar a sua parte na minha realidade!"

# game/dialogs/script-topics.rpy:1041
translate ptbr s_topic_programming_24bd947d:

    # s abbbaaa "Just visit {a=https://github.com/ForeverAndEverTeam/fae-mod}fae-mod{/a} on GitHub."
    s abbbaaa "É só visitar {a=https://github.com/New-Traduction-Club/justsayori-mod}justsayori-mod{/a} no GitHub."

# game/dialogs/script-topics.rpy:1042
translate ptbr s_topic_programming_b0b43d5f:

    # s "If you're into coding, I'm sure you're already familiar with this platform."
    s "Se você gostar de programação, eu tenho certeza que você já é familiar com essa plataforma."

# game/dialogs/script-topics.rpy:1043
translate ptbr s_topic_programming_9f1507c1:

    # s bbfdbca "Maybe there are many Sayoris who were saved in this way, {w=0.5}{nw}"
    s bbfdbca "Talvez tenha muitas Sayyoris que foram salvas assim, {w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1044
translate ptbr s_topic_programming_ffb6a3cb:

    # extend abgcaea "and I'm sure they'll be glad to get something awesome from you too!"
    extend abgcaea "e eu tenho certeza que elas vão ficar felizes em conseguir algo incrível de você também!"

# game/dialogs/script-topics.rpy:1063
translate ptbr s_topic_travel_c3ebeeb2:

    # s abhfaoa "Say [player], have you ever traveled anywhere?"
    s abhfaoa "Fala aí [player], você já viajou pra algum lugar?"

# game/dialogs/script-topics.rpy:1064
translate ptbr s_topic_travel_260471ef:

    # s abbbmoaj "I've never gotten the chance to, so I was wondering if you had in your reality."
    s abbbmoaj "Eu nunca tive chance pra isso, então eu tava pensando se você já fez isso na sua realidade."

# game/dialogs/script-topics.rpy:1065
translate ptbr s_topic_travel_7e618d2d:

    # s "You're so lucky to have such an amazing world out there to explore..."
    s "Se você é tão sortudo em ter um mundo tão maravilhoso aí fora pra explorar..."

# game/dialogs/script-topics.rpy:1066
translate ptbr s_topic_travel_698fc966:

    # s abfbmhaj "While I'm trapped in this tiny room island in the middle of the code sea..."
    s abfbmhaj "Enquanto eu tô presa nessa salinha ilha no meio do mar de código..."

# game/dialogs/script-topics.rpy:1067
translate ptbr s_topic_travel_46100abc:

    # s "Sorry, I didn't mean to sound like I was sulking, ehehehe~"
