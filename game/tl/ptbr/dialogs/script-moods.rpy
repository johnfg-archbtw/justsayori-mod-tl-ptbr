# game/dialogs/script-moods.rpy:317
translate ptbr s_mood_sick_c4a257e6:

    # extend bbgccoa "and I don't think sitting in front of a screen will get you healed up any quicker!"
    extend bbgccoa "e eu não acho que sentar na frente de uma tela vai te curar mais rápido!"

# game/dialogs/script-moods.rpy:318
translate ptbr s_mood_sick_f4988f04:

    # s bbhfaaa "I'm not going anywhere, {w=0.5}{nw}"
    s bbhfaaa "Eu não vou a lugar nenhum, {w=0.5}{nw}"

# game/dialogs/script-moods.rpy:319
translate ptbr s_mood_sick_63541f8c:

    # extend abhfcaa "and we can talk whenever you feel up to it again!"
    extend abhfcaa "e a gente pode conversar quando você se sentir disposto de novo!"

# game/dialogs/script-moods.rpy:320
translate ptbr s_mood_sick_29582eb1:

    # s abhfaoa "Get well soon, [player]!"
    s abhfaoa "Fique bem logo, [player]!"

# game/dialogs/script-moods.rpy:336
translate ptbr s_mood_nervous_446622f8:

    # s abhfica "Oh? You’re nervous about something [player]? Did something happen?"
    s abhfica "Ah? Você tá nervoso sobre algo [player]? Alguma coisa aconteceu?"

# game/dialogs/script-moods.rpy:337
translate ptbr s_mood_nervous_346a9d04:

    # s abgbica "Whatever it is that’s stressing you, {w=0.5}{nw}"
    s abgbica "O que quer que esteja te estressado, {w=0.5}{nw}"

# game/dialogs/script-moods.rpy:338
translate ptbr s_mood_nervous_121aefdd:

    # extend abgbcaa "we’re in this together!"
    extend abgbcaa "a gente tá nessa junto!"

# game/dialogs/script-moods.rpy:339
translate ptbr s_mood_nervous_2be1e2ea:

    # s abbbiaa "But try not to overthink things, {w=0.5}{nw}"
    s abbbiaa "Mas tenta não pensar demais nas coisas, {w=0.5}{nw}"

# game/dialogs/script-moods.rpy:340
translate ptbr s_mood_nervous_363fec4b:

    # extend abbbaca "we often judge ourselves too harshly."
    extend abbbaca "a gente frequentemente pega pesado demais com nós mesmos."

# game/dialogs/script-moods.rpy:342
translate ptbr s_mood_nervous_26a95063:

    # s abgccab "I truly love you [player], and no matter what happens, I’ll always support you."
    s abgccab "Eu verdadeiramente te amo [player], e não importa o que acontecer, eu vou sempre te apoiar."

# game/dialogs/script-moods.rpy:344
translate ptbr s_mood_nervous_13ea5c12:

    # s abgccaa "No matter what happens, I’ll always support you."
    s abgccaa "Não importa o que acontecer, eu sempre vou te apoiar."

# game/dialogs/script-moods.rpy:360
translate ptbr s_mood_unmotivated_f3e935e0:

    # s bbhaaab "Aww... I understand that feeling all too well, {w=0.5}{nw}"
    s bbhaaab "Aww... Eu entendo todo esse sentimento bem demais, {w=0.5}{nw}"

# game/dialogs/script-moods.rpy:361
translate ptbr s_mood_unmotivated_40402da1:

    # extend abbcaaa "but I'm sure you'll get your motivation back, [player]."
    extend abbcaaa "mas eu tenho certeza que você vai conseguir a sua motivação de volta, [player]."

# game/dialogs/script-moods.rpy:362
translate ptbr s_mood_unmotivated_bb3a4981:

    # s abbbaca "Maybe you could try to write a poem about your emotions, just like I always did?"
    s abbbaca "Talvez você podia tentar escrever um poema sobre as suas emoções, assim como eu fiz?"

# game/dialogs/script-moods.rpy:363
translate ptbr s_mood_unmotivated_3844595d:

    # s abbcaca "I found it helpful to let it all out in some way and be honest with myself."
    s abbcaca "Eu achei isso útil pra desabafar de algum jeito e ser honesta comigo mesma."

# game/dialogs/script-moods.rpy:364
translate ptbr s_mood_unmotivated_9621c3fa:

    # s abgccoa "And it also might help you find some inspiration to get you motivated again!"
    s abgccoa "E pode te ajudar a encontrar alguma inspiração e te motivar de novo!"

# game/dialogs/script-moods.rpy:365
translate ptbr s_mood_unmotivated_5622c906:

    # s abbbaaa "Just don't ever give up on anything you do!"
    s abbbaaa "Só não desiste em tudo que você fazer!"

# game/dialogs/script-moods.rpy:366
translate ptbr s_mood_unmotivated_2cd6e51d:

    # s abhfaoa "Keep going, and with enough determination, I know you'll reach your goals!"
    s abhfaoa "Continua assim, e com motivação o suficiente, eu sei que você vai alcançar os seus objetivos!"

# game/dialogs/script-moods.rpy:367
translate ptbr s_mood_unmotivated_fa508358:

    # s abbbaaa "And If you need to, there's no shame in giving yourself some time to rest and take a break from things as well."
    s abbbaaa "E se você precisar, não tem problema em te dar um tempo pra descansar e fazer uma pausa das coisas também."

# game/dialogs/script-moods.rpy:368
translate ptbr s_mood_unmotivated_71af5fa0:

    # s abgccoa "After a while, some motivation should pop back up into that unmotivated brain of yours!"
    s abgccoa "Depois de um tempo, alguma motivação pode voltar pra esse cérebro desmotivado seu!"

# game/dialogs/script-moods.rpy:384
translate ptbr s_mood_depressed_fc37d876:

    # s bbhfjla "[player]... I'm so sorry to hear that."
    s bbhfjla "[player]... Sinto muito em ouvir isso."

# game/dialogs/script-moods.rpy:385
translate ptbr s_mood_depressed_5ffaa228:

    # s bbhfica "Please remember that no matter what your mind tells you, you are an amazing, sweet and lovely person."
    s bbhfica "Por favor lembra que não importa o que a sua mente te dizer, você é uma pessoa maravilhosa, doce e amorosa."

# game/dialogs/script-moods.rpy:386
translate ptbr s_mood_depressed_43b99b44:

    # s bbhaila "Don't let those bad thoughts, those rainclouds, control you."
    s bbhaila "Não deixa esses pensamentos ruins, essas nuvens de chuva, te controlarem."

# game/dialogs/script-moods.rpy:387
translate ptbr s_mood_depressed_d2a7f88b:

    # s bbbbaca "Trust me when I say that there are people who care about you and want to help you."
    s bbbbaca "Confia em mim quando eu falar que tem gente que se preocupa com você e que querem te ajudar."

# game/dialogs/script-moods.rpy:388
translate ptbr s_mood_depressed_37471f34:

    # s "You are not alone, never ever, okay?"
    s "Você não tá sozinho, nunca jamais, tá?"

# game/dialogs/script-moods.rpy:389
translate ptbr s_mood_depressed_61525718:

    # s bbbcjfag "Don't ever do the same horrible mistakes I did. Please reach out to someone and vent about your emotions… it really might help you feel better."
    s bbbcjfag "Nunca faça os mesmos erros horríveis que eu fiz. Por favor procura alguém pra desabafar sobre as suas emoções… isso realmente pode te ajudar a se sentir melhor."

# game/dialogs/script-moods.rpy:391
translate ptbr s_mood_depressed_b18701ef:

    # s bbgbacb "[player]... I love you so, so much. I’m always here for you, through the good times and the not-so-good times, and I’ll try my best to help you as much as I can from here."
    s bbgbacb "[player]... Eu te amo tanto, tanto. Eu sempre tô aqui pra você, durante os momentos bons e os não-tão-bons, e eu vou tentar o meu melhor pra te ajudar o máximo que eu puder aqui."

# game/dialogs/script-moods.rpy:392
translate ptbr s_mood_depressed_1d573dd5:

    # s bbbbaaa "Just don't give up and keep going forward okay?"
    s bbbbaaa "Só não desiste e continua seguindo em frente, ok?"

# game/dialogs/script-moods.rpy:393
translate ptbr s_mood_depressed_e1de2c58:

    # s bbhfica "Because no matter how loud those rainclouds get and no matter how hard things seem to be… there is always a glimpse of hope. A light at the end of the tunnel."
    s bbhfica "Porque não importa o quão barulhentas essas nuvens de chuva forem e não importa o quão difícil as coisas parecem ser… sempre tem um raio de esperança. Uma luz no fim do túnel."

# game/dialogs/script-moods.rpy:394
translate ptbr s_mood_depressed_fdd9f344:

    # s bbhfifa "Giving up is the worst thing you can do… I learned that myself..."
    s bbhfifa "Desistir é a pior coisa que você pode fazer… Eu pessoalmente aprendi isso..."

# game/dialogs/script-moods.rpy:395
translate ptbr s_mood_depressed_3c9029c2:

    # s bbbbica "So if you ever need to spend some time with me then go ahead and we can just talk, alright?"
    s bbbbica "Então se você alguma vez precisar passar o tempo comigo então só vai em frente e a gente pode conversar, tudo bem?"

# game/dialogs/script-moods.rpy:396
translate ptbr s_mood_depressed_5f4e99c6:

    # s bbgcaaa "Remember I am always here if you need anything, no matter how small."
    s bbgcaaa "Lembra que eu sempre tô aqui se você precisar de alguma coisa, não importa o quão pequena for."

# game/dialogs/script-moods.rpy:398
translate ptbr s_mood_depressed_6e370263:

    # s bbfcaab "I love you [player], forever and ever."
    s bbfcaab "Eu te amo [player], para sempre e sempre."

